{
  "name": "ghost-runner",
  "version": "1.0.0",
  "description": "",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "tsx src/core/index.ts",
    "bot": "tsx src/core/index.ts",
    "record": "tsx src/core/record-new-task.ts",
    "schedule": "tsx src/core/scheduler.ts",
    "setup-login": "tsx src/utils/run-setup-login.ts",
    "verify-login": "tsx src/utils/verify-session.ts",
    "build:frontend": "cd frontend && pnpm install && pnpm run build",
    "clean:frontend": "rm -rf frontend/dist",
    "build:frontend:verified": "node scripts/verify-frontend-build.js --clean",
    "build:server": "tsc -p tsconfig.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "deploy:frontend": "pnpm run build:frontend && rm -rf src/server/public/* && mkdir -p src/server/public && cp -r frontend/dist/* src/server/public/",
    "ui:prod": "pnpm run deploy:frontend && tsx src/server/index.ts",
    "ui": "tsx dev-runner.ts",
    "electron:start": "electron dist-electron/main.js",
    "electron:dev": "pnpm run build:frontend:verified && pnpm run build:server && pnpm run build:electron && pnpm run electron:start",
    "electron:dist": "pnpm run build:frontend:verified && pnpm run build:server && pnpm run build:electron && electron-builder --mac --publish never",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov node --test test/**/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicius741/ghost-runner.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vinicius741/ghost-runner/issues"
  },
  "homepage": "https://github.com/vinicius741/ghost-runner#readme",
  "dependencies": {
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "c8": "^11.0.0",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.ghostrunner.desktop",
    "productName": "Ghost Runner",
    "asar": true,
    "asarUnpack": [
      "frontend/dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "frontend/dist/**/*",
      "tasks/public/**/*",
      "tasks/private/**/*",
      "src/server/public/**/*",
      "settings.json",
      "schedule.json",
      "failures.json",
      "info-gathering.json",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "NSLocationUsageDescription": "Ghost Runner uses your location to configure browser geolocation for automation tasks.",
        "NSLocationWhenInUseUsageDescription": "Ghost Runner uses your location to configure browser geolocation for automation tasks."
      }
    }
  },
  "packageManager": "pnpm@9.15.5+sha512.845196026aab1cc3f098a0474b64dfbab2afe7a1b4e91dd86895d8e4aa32a7a6d03049e2d0ad770bbe4de023a7122fb68c1a1d6e0d033c7076085f9d5d4800d4"
}
